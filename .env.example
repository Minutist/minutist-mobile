# Example environment for local dev/test builds. Copy to `.env.local` (which is
# gitignored) and fill in real values — never commit a real token.
#
# Vite inlines any VITE_-prefixed variable into the built bundle at build time.

# Admission token for the gated sync relay (sync.minutist.ai). Required for the
# companion to connect the relay during development. Obtain the current dev
# token from the relay deployment (minutist-relay: deploy/iroh-relay.env).
#
# NOTE: this is a build-time, bundle-inlined token — for development only. It is
# NOT the production mechanism: shipped builds will fetch a per-user admission
# token from the account service at runtime. Do not treat this as secure.
VITE_RELAY_AUTH_TOKEN=
