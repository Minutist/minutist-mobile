node_modules/
dist/
*.tsbuildinfo

# Local env / secrets — never commit
.env
*.env
.env.local
.env.*.local
!*.env.example

# Capacitor / Android build outputs (the android/ project itself IS committed)
android/app/build/
# The sync plugin's cross-compiled Rust library is a ~140 MB build artifact,
# never committed — regenerate via scripts/build-sync-ffi.sh. (The generated
# Kotlin bindings under android/app/src/main/java/uniffi/ ARE committed.)
android/app/src/main/jniLibs/**/*.so
android/build/
android/.gradle/
android/captures/
android/local.properties
android/app/release/
*.apk
*.aab
*.keystore
*.jks
keystore.properties

.DS_Store

# Host-side Gradle cache (mounted into the headless build container)
.gradle-cache/
