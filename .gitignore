node_modules/
dist/
*.tsbuildinfo

# Local env / secrets — never commit
.env
*.env
.env.local
.env.*.local
!*.env.example

# Capacitor / Android build outputs (the android/ project itself IS committed)
android/app/build/
# The sync plugin's cross-compiled Rust library is a ~140 MB build artifact,
# never committed — regenerate via scripts/build-sync-ffi.sh. (The generated
# Kotlin bindings under android/app/src/main/java/uniffi/ ARE committed.)
android/app/src/main/jniLibs/**/*.so
android/build/
android/.gradle/
android/captures/
android/local.properties
android/app/release/
*.apk
*.aab
*.keystore
*.jks
# Exception: the fixed DEBUG keystore is committed on purpose so `adb install -r`
# stays stable across docker rebuilds (no uninstall / no app-data loss). Non-secret
# (standard android/androiddebugkey creds); cannot sign a release. The blanket
# *.keystore/*.jks rules above still exclude every other keystore, incl. release keys.
!android/app/debug.keystore
keystore.properties
# App Store Connect API keys (ES256 private keys). Apple lets you download one
# exactly once, so a leaked key is replaced rather than rotated quietly; they
# live off-repo alongside the upload keystore.
*.p8
*.pk8

# The iOS native library, the counterpart of the gitignored Android .so. Built
# by scripts/build-sync-ffi-ios.sh from the desktop repo's crates/sync-ffi; the
# generated Swift bindings beside it ARE committed, exactly as sync_ffi.kt is on
# the Android side.
ios/SyncFfi.xcframework/

.DS_Store

# Capacitor / iOS build outputs (the ios/ project itself IS committed).
# ios/.gitignore and ios/App/CapApp-SPM/.gitignore cover the template's own
# build products (App/build, App/output, App/Pods, App/App/public, the
# regenerated capacitor.config.json/config.xml, capacitor-cordova-ios-plugins,
# DerivedData and xcuserdata anywhere under ios/); this only adds what the
# template's own ignore files omit — the whole local SPM working directory,
# not just the two files under it that CapApp-SPM/.gitignore names.
ios/App/CapApp-SPM/.swiftpm/

# Host-side Gradle cache (mounted into the headless build container)
.gradle-cache/

# Play service-account credential (fastlane supply) — never commit
fastlane/*.json
fastlane/report.xml
